  <EnglishText>
    <Row Tag="LOC_MTG_FORCE_TURN_HOLD">
      <Text>Hold for 1 second to [icon:NEXT_TURN] force end turn</Text>
    </Row>
    <Row Tag="LOC_MTG_FORCE_TURN_RELEASE">
      <Text>Release to [icon:NEXT_TURN] force end turn</Text>
    </Row>
    <Row Tag="LOC_MTG_MOD_NAME">
      <Text>Better Controller Support</Text>
    </Row>
    <Row Tag="LOC_MTG_DESCRIPTION">
      <Text>Controller map tools, stacked-unit cycling and settlement shortcuts. Optional stick compatibility can be switched on or off in Options → Add-ons → Better Controller Support. City/unit/wonder lists require Map Trix; map tacks require Detailed Map Tacks.</Text>
    </Row>
    <Row Tag="LOC_MTG_TITLE">
      <Text>Map Tools</Text>
    </Row>
    <Row Tag="LOC_MTG_LENSES">
      <Text>Lenses</Text>
    </Row>
    <Row Tag="LOC_MTG_CITIES">
      <Text>Cities</Text>
    </Row>
    <Row Tag="LOC_MTG_UNITS">
      <Text>Units</Text>
    </Row>
    <Row Tag="LOC_MTG_WONDERS">
      <Text>Wonders</Text>
    </Row>
    <Row Tag="LOC_MTG_TACKS">
      <Text>Map Tacks</Text>
    </Row>
      <Row Tag="LOC_MTG_SCROLL_CENTER"><Text>Press: focus visible centre</Text></Row>
    <Row Tag="LOC_MTG_SCROLL_SWITCH"><Text>← → Switch scroll area</Text></Row>
  </EnglishText>
