<ActionCriteria><Criteria id="always"><AlwaysMet /></Criteria></ActionCriteria>
<ActionGroups><ActionGroup id="bms-shell" scope="shell" criteria="always"><Properties><LoadOrder>1000</LoadOrder></Properties><Actions><UpdateText><Item>text/launcher.xml</Item></UpdateText><UIScripts><Item>ui/bms-bootstrap.js</Item></UIScripts><ImportFiles><Item>ui/bms-api.js</Item><Item>ui/bms-registry.js</Item><Item>ui/bms-preference-transport.js</Item><Item>ui/bms-options.js</Item><Item>ui/bms-dialog-navigation.js</Item></ImportFiles></Actions></ActionGroup><ActionGroup id="bms-game" scope="game" criteria="always"><Properties><LoadOrder>1000</LoadOrder></Properties><Actions><UpdateText><Item>text/launcher.xml</Item></UpdateText><UIScripts><Item>ui/bms-bootstrap.js</Item></UIScripts><ImportFiles><Item>ui/bms-api.js</Item><Item>ui/bms-registry.js</Item><Item>ui/bms-preference-transport.js</Item><Item>ui/bms-options.js</Item><Item>ui/bms-dialog-navigation.js</Item></ImportFiles></Actions></ActionGroup></ActionGroups></Mod>
