<?xml version="1.0" encoding="utf-8"?>
<Mod xmlns="ModInfo" id="civ7-mac-launcher" version="1">
  <Properties><Name>LOC_C7ML_NAME</Name><Description>LOC_C7ML_DESCRIPTION</Description><Authors>Stupidism</Authors><Version>0.1.0-dev</Version><Package>Mod</Package><AffectsSavedGames>0</AffectsSavedGames><ShowInBrowser>1</ShowInBrowser><EnabledByDefault>0</EnabledByDefault></Properties>
