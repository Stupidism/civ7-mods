<?xml version='1.0' encoding='utf-8'?>
<Mod xmlns="ModInfo" id="civ7-fenhe" version="2">
 <Properties>
  <Name>分合</Name>
  <Description>分合：推演天下兴亡，通过本地接入器在原地图创建新时代国家与城邦。实验版。</Description>
  <Authors>Custom Mod</Authors>
  <Version>0.2.0-alpha</Version>
  <AffectsSavedGames>1</AffectsSavedGames>
  <ShowInBrowser>1</ShowInBrowser>
  <EnabledByDefault>1</EnabledByDefault>
 </Properties>
 <Dependencies>
  <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
 </Dependencies>
 <ActionCriteria>
  <Criteria id="always">
   <AlwaysMet />
  </Criteria>
  <Criteria id="fenhe-cs-identities">
   <MapInUse>{civ7-fenhe}maps/Fenhe_Intervention.Civ7Map</MapInUse>
  </Criteria>
  <Criteria id="fenhe-cs-0-economic">
   <MapInUse>{civ7-fenhe}maps/Fenhe_Intervention.Civ7Map</MapInUse>
   <ConfigurationValueMatches>
    <Group>Game</Group>
    <ConfigurationId>FenheMinor0</ConfigurationId>
    <Value>ECONOMIC</Value>
   </ConfigurationValueMatches>
  </Criteria>
  <Criteria id="fenhe-cs-0-expansionist">
   <MapInUse>{civ7-fenhe}maps/Fenhe_Intervention.Civ7Map</MapInUse>
