<?xml version="1.0" encoding="utf-8"?>
<Mod xmlns="ModInfo" id="civ7-fenhe-ui" version="2">
 <Properties>
  <Name>分合 · 界面</Name>
  <Description>允许从既有单人存档打开分合推演与世界接入面板。</Description>
  <Authors>Custom Mod</Authors>
  <Version>0.2.0-alpha</Version>
  <AffectsSavedGames>0</AffectsSavedGames>
  <ShowInBrowser>1</ShowInBrowser>
  <EnabledByDefault>1</EnabledByDefault>
 </Properties>
 <Dependencies><Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/></Dependencies>
 <ActionCriteria><Criteria id="always"><AlwaysMet/></Criteria></ActionCriteria>
 <ActionGroups>
  <ActionGroup id="fenhe-compatible-ui" scope="game" criteria="always">
   <Actions>
    <ImportFiles><Item>ui/fenhe.js</Item><Item>ui/snapshot.js</Item><Item>sim/engine.js</Item><Item>sim/topology.js</Item><Item>sim/config.js</Item></ImportFiles>
    <UIScripts><Item>ui/fenhe.js</Item></UIScripts>
   </Actions>
  </ActionGroup>
 </ActionGroups>
</Mod>
