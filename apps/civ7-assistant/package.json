{
  "name": "civ7-assistant",
  "productName": "文明7小助手",
  "version": "0.1.0",
  "description": "文明 VII 存档设置复制、完整备份与离线截图识别",
  "author": "Stupidism",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "start": "npm run prepare:app && electron .",
    "test": "npm run prepare:app && node --test tests/*.test.mjs",
    "smoke": "npm run prepare:app && node tests/smoke.mjs",
    "dist:mac": "npm run prepare:app && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:win": "npm run prepare:app && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.stupidism.civ7assistant",
    "asar": false,
    "directories": { "output": "dist" },
    "files": ["app/**/*", "ui/**/*", "shared/**/*", "companion/**/*", "package.json"],
    "artifactName": "Civ7Assistant-${version}-${os}-${arch}.${ext}",
    "mac": { "category": "public.app-category.utilities", "target": "dmg", "identity": null },
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "dmg": { "title": "文明7小助手" }
  }
}
